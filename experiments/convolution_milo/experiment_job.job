#SBATCH --ntasks-per-node=1 
#SBATCH --gres=gpu:A4000-Ada:1
#SBATCH --time=00:15:00
#SBATCH --job-name=kernel_tuner_parallel_exp

module load python/3.10
module load cuda/11.8

# Create virtual environment if needed
if [ ! -d "venv" ]; then
    python -m venv venv
    source venv/bin/activate
    pip install --quiet kernel_tuner numpy
else 
    source venv/bin/activate
fi

# Run your experiment
python parallel_full_experiment.py

echo "Experiment completed at $(date)"