#!/bin/bash
#SBATCH --ntasks-per-node=32
#SBATCH --gres=gpu:A4000-Ada:1
#SBATCH --time=12:00:00
#SBATCH --job-name=kernel_tuner_parallel_exp
#SBATCH --output=logs/%j_parallel_exp.out
#SBATCH --error=logs/%j_parallel_exp.err

. /etc/bashrc
. /etc/profile.d/lmod.sh

mkdir -p logs results cachefiles/convolution_milo

# Correct CUDA module name
module load cuda12.1/toolkit/12.1

# Use local kernel_tuner
export PYTHONPATH=/home/fschuiri/Scriptie/kernel_tuner:$PYTHONPATH

python3.12 parallel_full_experiment.py
EXITCODE=$?

exit $EXITCODE