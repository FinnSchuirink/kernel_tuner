#!/bin/bash
#SBATCH --ntasks-per-node=32
#SBATCH --gres=gpu:A4000-Ada:1
#SBATCH --time=00:15:00
#SBATCH --job-name=kernel_tuner_cache_small_exp
#SBATCH --output=logs/%j_cache_small_exp.out
#SBATCH --error=logs/%j_cache_small_exp.err

cd /home/fschuiri/Scriptie/kernel_tuner/experiments/caching/convolution_milo/small_experiment

. /etc/bashrc
. /etc/profile.d/lmod.sh

mkdir -p logs results

# Correct CUDA module name
module load cuda12.1/toolkit/12.1

# Use local kernel_tuner
export PYTHONPATH=/home/fschuiri/Scriptie/kernel_tuner:$PYTHONPATH

python3.12 small_cache_experiment_between_runs.py
EXITCODE=$?

exit $EXITCODE