#!/bin/bash
#SBATCH --ntasks-per-node=32
#SBATCH --gres=gpu:A4000-Ada:1
#SBATCH --time=72:00:00
#SBATCH --job-name=kernel_tuner_cache_in_run_exp
#SBATCH --output=logs/%j_cache_exp_in_run.out
#SBATCH --error=logs/%j_cache_exp_in_run.err

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$SCRIPT_DIR"

. /etc/bashrc
. /etc/profile.d/lmod.sh

mkdir -p logs results

# Correct CUDA module name
module load cuda12.1/toolkit/12.1

# Use local kernel_tuner
KT_ROOT="$( cd "$SCRIPT_DIR/../../.." && pwd )"
export PYTHONPATH="$KT_ROOT:$PYTHONPATH"

python3.12 cache_experiment_in_run.py
EXITCODE=$?

exit $EXITCODE